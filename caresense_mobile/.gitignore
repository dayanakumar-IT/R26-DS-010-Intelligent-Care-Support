# Backend env files — never commit secrets
backend/sentry_service/.env
backend/scribe_service/.env

# Backend model weights — too large for git
backend/sentry_service/models/*.pth
backend/sentry_service/models/*.pt
backend/scribe_service/models/*.pth
backend/scribe_service/models/*.pt
backend/scribe_service/models/*.bin

# Python
__pycache__/
*.pyc
*.pyo
.venv/
venv/
*.egg-info/

# Flutter (frontend handles its own .gitignore)
frontend/.dart_tool/
frontend/build/
