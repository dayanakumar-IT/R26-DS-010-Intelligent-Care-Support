# Vite — Supabase client config, see src/services/supabaseClient.ts
# Frontend uses anon/publishable key only — never put service_role/secret here.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# deterioration-detection backend base URL (backend_services/deterioration-detection).
# Defaults to http://localhost:8000 if unset — see src/modules/deterioration-detection/services/api.ts
VITE_DETERIORATION_API_URL=
