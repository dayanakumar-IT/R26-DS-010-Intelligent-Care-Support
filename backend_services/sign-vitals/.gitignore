# GLOSS — second venv for MediaPipe (kept separate from .venv/TensorFlow)
.venv_mediapipe/

# GLOSS — local test video clips, not committed
test_samples/

# GLOSS model binaries (large artifacts stay untracked); class_names.json
# is a lightweight runtime config file the recognition/evaluation
# endpoints need, so it's tracked.
models/*
!models/class_names.json
