# Sign & Vitals backend (backend_services/sign-vitals) — copy to .env and fill in.
# .env is gitignored: never commit real keys. See README_SETUP.md.

# --- Supabase (required) -------------------------------------------------
# Project URL and the SERVICE ROLE key (backend only — never put it in the frontend).
SUPABASE_URL=https://<project-ref>.supabase.co
SUPABASE_SERVICE_ROLE_KEY=

# --- Gemini (optional) ---------------------------------------------------
# Rewords the rule-based feedback after the result is shown (guarded; the rule
# text stays if this is empty, fails or times out).
GEMINI_API_KEY=

# --- Cloudflare R2 (optional; needed for the Reference Video tab and the
# Parkinson's symptom videos). Without them those tabs say "not available" and
# the 2D Sign Guide / 3D Signer still work.
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=
R2_ENDPOINT=https://<account-id>.r2.cloudflarestorage.com

# --- GLOSS TEST caregiver (optional; written by scripts/create_test_caregiver.py)
# Used only by the end-to-end test scripts. Never a real caregiver.
GLOSS_TEST_CAREGIVER_EMAIL=
GLOSS_TEST_CAREGIVER_PASSWORD=
# Temporary test supervisor (scripts/create_test_supervisor.py; delete it after testing).
GLOSS_TEST_SUPERVISOR_EMAIL=
GLOSS_TEST_SUPERVISOR_PASSWORD=

# --- Behaviour flags (optional; leave unset for the normal behaviour) ------
# Feedback wording: v2 (default) names only the hands the sign uses; v1 = the
# thesis-evaluated wording. Recognition and grading are identical in both.
GLOSS_FEEDBACK_VERSION=
# 1 = one MediaPipe process per attempt (slower) instead of the long-running worker.
GLOSS_MEDIAPIPE_ONE_SHOT=
# 1 = split recognition / DTW timings in the attempt response (diagnostics).
GLOSS_TIMING_DETAIL=
# 1 = enable the login-free debug endpoints (local diagnosis only; never in a shared deployment).
GLOSS_ENABLE_DEBUG_ENDPOINTS=

# ==========================================================================
# Frontend — these go in frontend/.env (NOT this file):
#   VITE_SUPABASE_URL=https://<project-ref>.supabase.co
#   VITE_SUPABASE_ANON_KEY=<anon public key>
#   VITE_SIGNVITALS_API_URL=http://127.0.0.1:8009
# (Other components use VITE_DETERIORATION_API_URL and VITE_SCRIBE_API_URL.)
# ==========================================================================
