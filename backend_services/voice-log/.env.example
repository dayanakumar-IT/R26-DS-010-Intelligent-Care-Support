# SCRIBE (voice-log) — copy to .env and fill in values. Never commit .env.

# --- Cloudflare R2 (audio + TTS summaries) ---
R2_ACCOUNT_ID=7e9234ca191f657d17ee219ce4935e62
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=caresense-voice-models
R2_ENDPOINT=https://7e9234ca191f657d17ee219ce4935e62.r2.cloudflarestorage.com

# --- Supabase (secret/service_role — backend only, NEVER in frontend/.env) ---
# Dashboard → Project Settings → API → Secret key (sb_secret_...)
# or Legacy API keys → service_role (eyJ... JWT). Not the anon/publishable key.
SUPABASE_URL=https://mxxpfvxpbktlturlrrae.supabase.co
SUPABASE_SERVICE_ROLE_KEY=

# --- API server ---
API_HOST=0.0.0.0
API_PORT=8004

# --- Local model paths (extract ZIPs into models/ — see MODEL_SETUP below) ---
SCRIBE_WHISPER_BASE_MODEL=openai/whisper-small
SCRIBE_WHISPER_ADAPTER_PATH=models/whisper_lora
SCRIBE_BART_MODEL_PATH=models/bart_disfluency
SCRIBE_T5_MODEL_PATH=models/t5_stage5

# Set true ONLY for API smoke tests without ML models (returns a fixed demo transcript).
# Set false for real Whisper+BART+T5 inference on recorded audio.
SCRIBE_MOCK_PIPELINE=false
